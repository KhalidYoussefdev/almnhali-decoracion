# Site
NEXT_PUBLIC_SITE_URL=https://almnhali.com

# Persist ALL admin data (products, settings, uploads, orders, users)
# DATA_DIR=/home/YOUR_USER/almnhali-data

# Moyasar (live keys from dashboard.moyasar.com after approval)
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=pk_live_xxxxxxxx
MOYASAR_SECRET_KEY=sk_live_xxxxxxxx

# Admin panel password
ADMIN_PASSWORD=change-me

# Customer session signing (optional; defaults if unset)
AUTH_SECRET=change-me-to-a-long-random-string
